{
  "name": "ofiword-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Generador de casos prácticos de Microsoft Word con rúbrica, maqueta A4 y hoja de calificación en PDF.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build && vite build --mode offline && node scripts/copiar-offline.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
